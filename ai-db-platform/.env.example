# ============================================================
# AI Enterprise Database Architect Platform
# Environment Variables — Copy to .env and fill values
# ============================================================

# ── PostgreSQL (Platform's own DB) ──────────────────────────
# Local dev: use docker-compose postgres
# Production: use Neon (neon.tech — free tier)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_db_platform
POSTGRES_USER=aidbuser
POSTGRES_PASSWORD=localdev123
DATABASE_URL=postgresql://aidbuser:localdev123@localhost:5432/ai_db_platform

# ── Redis ───────────────────────────────────────────────────
# Local dev: docker-compose redis
# Production: Upstash Redis (upstash.com — free tier)
REDIS_URL=redis://localhost:6379

# ── JWT Secrets ─────────────────────────────────────────────
JWT_SECRET=change_this_to_very_long_random_secret_min_64_chars_xxxxxxxxxxxx
JWT_REFRESH_SECRET=different_long_random_secret_for_refresh_token_xxxxxxxxxxxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption (for storing user DB credentials) ────────────
# Must be exactly 32 characters
ENCRYPTION_KEY=change_this_32char_encryption_key

# ── LLM Configuration ───────────────────────────────────────
# Provider: groq | gemini | openai | ollama | mistral
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# API Keys (only fill the one you're using)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Ollama (local development only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Backend (Node.js) ───────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Internal secret for backend ↔ AI service communication
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=internal_secret_change_this_xxxxxxxxxxxx

# ── Query Execution Limits ──────────────────────────────────
MAX_QUERY_ROWS=10000
QUERY_TIMEOUT_MS=30000

# ── AI Service (Python) ─────────────────────────────────────
PYTHON_ENV=development
AI_SERVICE_PORT=8000

# ── Frontend (Vite) ─────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_APP_NAME=AI Database Architect

# ── Production Overrides ────────────────────────────────────
# Vercel Frontend URL
# FRONTEND_URL=https://your-app.vercel.app

# Neon DB (production)
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require

# Render Backend URL
# AI_SERVICE_URL=https://your-ai-service.onrender.com

# Upstash Redis (production)
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379
